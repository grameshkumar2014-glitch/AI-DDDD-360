    "principles": [
      "Never silently equate E1 with E6",
      "Binding does not equal efficacy",
      "Preserve conflicting evidence",
      "Preserve uncertainty",
      "Separate evidence from inference",
      "Separate hypothesis from demonstrated effect",
      "Preserve provenance",
      "Require human oversight for consequential interpretation"
